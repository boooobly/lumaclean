NEXT_PUBLIC_SITE_URL=https://lumacleanrs.com
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Production only; analytics loads after visitor consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Admin only. Neon pooled URL (-pooler) for application connections.
DATABASE_URL=
# Neon direct URL for Prisma migrations, same database/branch as DATABASE_URL.
DIRECT_URL=
# Minimum 32 random characters; never NEXT_PUBLIC_*.
BETTER_AUTH_SECRET=
# Exact origin: http://localhost:3000 locally, https://lumacleanrs.com in production.
BETTER_AUTH_URL=

# Google Maps Platform: enable Places API (New) and Routes API. Server only.
GOOGLE_MAPS_SERVER_API_KEY=
# Optional: Maps JavaScript API, restrict HTTP referrers to the deployed domain.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
# Optional production map ID for Advanced Markers / cloud Quiet Architecture styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Central route freshness; transit buckets are 15 minutes.
GOOGLE_ROUTE_CACHE_TTL_SECONDS=600

# Server-side AI administrator. SHADOW is the initial BusinessSettings mode.
AI_AGENT_ENABLED=false
OPENROUTER_API_KEY=
POYO_API_KEY=
PRIMARY_AGENT_PROVIDER=poyo
PRIMARY_AGENT_MODEL=gpt-6-luna
PRIMARY_AGENT_INPUT_USD_PER_MILLION=0.08
PRIMARY_AGENT_OUTPUT_USD_PER_MILLION=0.4
FALLBACK_AGENT_PROVIDER=openrouter
FALLBACK_AGENT_MODEL=openai/gpt-6-luna
FALLBACK_AGENT_INPUT_USD_PER_MILLION=0.1
FALLBACK_AGENT_OUTPUT_USD_PER_MILLION=0.5
AI_DAILY_BUDGET_USD=5
# Distinct customer bot. Never reuse TELEGRAM_BOT_TOKEN (internal notifications).
TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_CUSTOMER_WEBHOOK_SECRET=
# Protected persisted-job recovery endpoint /api/agent/recover.
CRON_SECRET=

# Optional external transit verifier. A saved key alone never enables requests.
BUSMAPS_STATUS=PENDING_APPROVAL
BUSMAPS_API_KEY=
BUSMAPS_MONTHLY_ROUTE_LIMIT=1000
