NEXT_PUBLIC_SITE_URL=https://lumacleanrs.com
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Production only; analytics loads after visitor consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Admin only. Neon pooled URL (-pooler) for application connections.
DATABASE_URL=
# Neon direct URL for Prisma migrations, same database/branch as DATABASE_URL.
DIRECT_URL=
# Minimum 32 random characters; never NEXT_PUBLIC_*.
BETTER_AUTH_SECRET=
# Exact origin: http://localhost:3000 locally, https://lumacleanrs.com in production.
BETTER_AUTH_URL=

# Google Maps Platform: enable Places API (New) and Routes API. Server only.
GOOGLE_MAPS_SERVER_API_KEY=
# Optional: Maps JavaScript API, restrict HTTP referrers to the deployed domain.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
# Optional production map ID for Advanced Markers / cloud Quiet Architecture styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Central route freshness; transit buckets are 15 minutes.
GOOGLE_ROUTE_CACHE_TTL_SECONDS=600
